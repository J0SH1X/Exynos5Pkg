#
#  SensorTest.efi: probes the v1awifi sensors on I2C3 (BMA255, BMG160,
#  AK8963C, CM3323) and the hall (cover) input, then prints readings.
#
#  SPDX-License-Identifier: BSD-2-Clause-Patent
#

[Defines]
  INF_VERSION    = 0x00010005
  BASE_NAME      = SensorTest
  FILE_GUID      = 3c1f7e21-6a4d-4b0c-9c33-54201220c016
  MODULE_TYPE    = UEFI_APPLICATION
  VERSION_STRING = 1.0

  ENTRY_POINT    = SensorTestMain

[Sources.common]
  SensorTestApp.c

[Packages]
  MdePkg/MdePkg.dec
  ArmPkg/ArmPkg.dec
  Exynos5420Pkg/Exynos5420Pkg.dec

[LibraryClasses]
  BaseLib
  DebugLib
  IoLib
  UefiApplicationEntryPoint
  UefiBootServicesTableLib
  UefiLib

[Protocols]
  gExynosI2cProtocolGuid
