#
#  v1awifi camera ISP (FIMC-IS) bring-up test (shell application) over the
#  shared core (Drivers/Camera): ISP domain, clocks, firmware, secure
#  configuration, A5 start, first mailbox message.
#
#  SPDX-License-Identifier: BSD-2-Clause-Patent
#

[Defines]
  INF_VERSION    = 0x00010005
  BASE_NAME      = CameraTest
  FILE_GUID      = 3c1f7e21-6a4d-4b0c-9c33-54201220c01b
  MODULE_TYPE    = UEFI_APPLICATION
  VERSION_STRING = 1.0

  ENTRY_POINT    = CameraTestMain

[Sources.common]
  CameraTestApp.c
  ../../Drivers/Camera/FimcIsCore.h
  ../../Drivers/Camera/FimcIsCore.c
  ../../Drivers/Camera/FimcIsHost.h
  ../../Drivers/Camera/FimcIsHost.c
  ../../Drivers/Camera/CamBoard.h
  ../../Drivers/Camera/CamBoard.c
  ../../Drivers/Camera/CamCapture.h
  ../../Drivers/Camera/CamCapture.c
  ../../Drivers/Camera/CamSensorI2c.h
  ../../Drivers/Camera/CamSensorI2c.c
  ../../Drivers/Camera/CamAe.h
  ../../Drivers/Camera/CamAe.c

[Packages]
  MdePkg/MdePkg.dec
  ArmPkg/ArmPkg.dec
  Exynos5420Pkg/Exynos5420Pkg.dec

[LibraryClasses]
  BaseLib
  BaseMemoryLib
  CacheMaintenanceLib
  DebugLib
  IoLib
  MemoryAllocationLib
  TimerLib
  UefiApplicationEntryPoint
  UefiBootServicesTableLib
  UefiLib

[Protocols]
  gEfiLoadedImageProtocolGuid
  gEfiSimpleFileSystemProtocolGuid

  gExynosI2cProtocolGuid

[Guids]
  gEfiFileInfoGuid
