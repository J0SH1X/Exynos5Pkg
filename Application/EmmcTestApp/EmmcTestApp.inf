#
#  EmmcTest.efi: eMMC speed / interrupt / HS400 test (read + write verify,
#  throughput, read-strobe delay scan) over EXYNOS_MMC_TEST_PROTOCOL.
#
#  SPDX-License-Identifier: BSD-2-Clause-Patent
#

[Defines]
  INF_VERSION    = 0x00010005
  BASE_NAME      = EmmcTest
  FILE_GUID      = 3c1f7e21-6a4d-4b0c-9c33-54201220c020
  MODULE_TYPE    = UEFI_APPLICATION
  VERSION_STRING = 1.0

  ENTRY_POINT    = EmmcTestMain

[Sources.common]
  EmmcTestApp.c

[Packages]
  MdePkg/MdePkg.dec
  ArmPkg/ArmPkg.dec
  Exynos5420Pkg/Exynos5420Pkg.dec

[LibraryClasses]
  BaseLib
  BaseMemoryLib
  DebugLib
  MemoryAllocationLib
  PrintLib
  TimerLib
  UefiApplicationEntryPoint
  UefiBootServicesTableLib
  UefiLib

[Protocols]
  gExynosMmcTestProtocolGuid
  gEfiBlockIoProtocolGuid
  gEfiLoadedImageProtocolGuid
