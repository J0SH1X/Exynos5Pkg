#
#  Battery test: prints BatteryDxe's battery / charger status every second.
#
#  SPDX-License-Identifier: BSD-2-Clause-Patent
#

[Defines]
  INF_VERSION    = 0x00010005
  BASE_NAME      = BatteryTest
  FILE_GUID      = 3c1f7e21-6a4d-4b0c-9c33-54201220c013
  MODULE_TYPE    = UEFI_APPLICATION
  VERSION_STRING = 1.0

  ENTRY_POINT    = BatteryTestMain

[Sources.common]
  BatteryTestApp.c

[Packages]
  MdePkg/MdePkg.dec
  Exynos5420Pkg/Exynos5420Pkg.dec

[LibraryClasses]
  UefiApplicationEntryPoint
  UefiBootServicesTableLib
  UefiLib

[Protocols]
  gExynosBatteryProtocolGuid
