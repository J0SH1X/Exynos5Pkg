#
#  PanelOff.efi: switch the panel + backlight fully off (saves ~1-2 A during
#  unattended tests).  Run DisplayTest.efi to light it again.
#
#  SPDX-License-Identifier: BSD-2-Clause-Patent
#

[Defines]
  INF_VERSION    = 0x00010005
  BASE_NAME      = PanelOff
  FILE_GUID      = 3c1f7e21-6a4d-4b0c-9c33-54201220c021
  MODULE_TYPE    = UEFI_APPLICATION
  VERSION_STRING = 1.0

  ENTRY_POINT    = PanelOffMain

[Sources.common]
  PanelOffApp.c
  ../../Drivers/Display/ExynosDisplay.h
  ../../Drivers/Display/ExynosDpCore.c
  ../../Drivers/Display/FimdCore.c
  ../../Drivers/Display/PanelCore.c

[Packages]
  MdePkg/MdePkg.dec
  ArmPkg/ArmPkg.dec
  Exynos5420Pkg/Exynos5420Pkg.dec

[LibraryClasses]
  BaseLib
  BaseMemoryLib
  DebugLib
  IoLib
  TimerLib
  UefiApplicationEntryPoint
  UefiBootServicesTableLib
  UefiLib

[Protocols]
  gExynosI2cProtocolGuid
