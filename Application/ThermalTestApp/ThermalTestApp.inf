[Defines]
  INF_VERSION    = 0x00010005
  BASE_NAME      = ThermalTest
  FILE_GUID      = 3c1f7e21-6a4d-4b0c-9c33-54201220c01a
  MODULE_TYPE    = UEFI_APPLICATION
  VERSION_STRING = 1.0

  ENTRY_POINT    = ThermalTestMain

[Sources.common]
  ThermalTestApp.c
  ../../Drivers/Thermal/TmuCore.h
  ../../Drivers/Thermal/TmuCore.c

[Packages]
  MdePkg/MdePkg.dec
  ArmPkg/ArmPkg.dec
  Exynos5420Pkg/Exynos5420Pkg.dec

[LibraryClasses]
  BaseLib
  BaseMemoryLib
  PrintLib
  DebugLib
  IoLib
  MemoryAllocationLib
  TimerLib
  UefiApplicationEntryPoint
  UefiBootServicesTableLib
  UefiLib

[Protocols]
  gExynosGpioProtocolGuid
  gEfiLoadedImageProtocolGuid
  gEfiSimpleFileSystemProtocolGuid

[Guids]
  gEfiFileInfoGuid
