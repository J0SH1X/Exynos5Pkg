[Defines]
  INF_VERSION    = 0x00010005
  BASE_NAME      = Exynos5420SmbiosPlatformDxe
  FILE_GUID      = 3c1f7e21-6a4d-4b0c-9c33-54201220c011
  MODULE_TYPE    = DXE_DRIVER
  VERSION_STRING = 1.0

  ENTRY_POINT    = SmbiosPlatformDxeInitialize

[Sources.common]
  SmbiosPlatformDxe.c

[Packages]
  ArmPkg/ArmPkg.dec
  MdeModulePkg/MdeModulePkg.dec
  MdePkg/MdePkg.dec
  Exynos5420Pkg/Exynos5420Pkg.dec

[LibraryClasses]
  ArmLib
  BaseLib
  BaseMemoryLib
  DebugLib
  HobLib
  IoLib
  MemoryAllocationLib
  PcdLib
  UefiBootServicesTableLib
  UefiDriverEntryPoint

[Guids]
  gEfiEndOfDxeEventGroupGuid

[Protocols]
  gEfiSmbiosProtocolGuid

[Pcd]
  gEfiMdeModulePkgTokenSpaceGuid.PcdFirmwareVersionString

[Depex]
  gEfiSmbiosProtocolGuid
