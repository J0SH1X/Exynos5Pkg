#
#  Exynos4 GPIO driver: installs gExynosGpioProtocolGuid over the
#  CON/DAT/PULL register banks of the three GPIO controllers.
#
#  SPDX-License-Identifier: BSD-2-Clause-Patent
#

[Defines]
  INF_VERSION    = 0x00010005
  BASE_NAME      = Exynos441xGpioDxe
  FILE_GUID      = 3c1f7e21-6a4d-4b0c-9c33-2a441220c001
  MODULE_TYPE    = DXE_DRIVER
  VERSION_STRING = 1.0

  ENTRY_POINT    = GpioDxeInitialize

[Sources.common]
  GpioDxe.c

[Packages]
  MdePkg/MdePkg.dec
  ArmPkg/ArmPkg.dec
  Exynos5420Pkg/Exynos5420Pkg.dec

[LibraryClasses]
  BaseLib
  DebugLib
  IoLib
  UefiBootServicesTableLib
  UefiDriverEntryPoint

[Protocols]
  gExynosGpioProtocolGuid

[Depex]
  TRUE
