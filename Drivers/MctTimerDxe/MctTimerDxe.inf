#
#  Timer Architecture Protocol driver on the Exynos4 MCT global comparator.
#
#  SPDX-License-Identifier: BSD-2-Clause-Patent
#

[Defines]
  INF_VERSION    = 0x00010005
  BASE_NAME      = Exynos5420MctTimerDxe
  FILE_GUID      = 6e6d6d4a-1b4b-4b0e-9b1c-2a441210c001
  MODULE_TYPE    = DXE_DRIVER
  VERSION_STRING = 1.0

  ENTRY_POINT    = TimerInitialize

[Sources.common]
  MctTimerDxe.c

[Packages]
  MdePkg/MdePkg.dec
  EmbeddedPkg/EmbeddedPkg.dec
  ArmPkg/ArmPkg.dec
  Exynos5420Pkg/Exynos5420Pkg.dec

[LibraryClasses]
  BaseLib
  DebugLib
  IoLib
  PcdLib
  UefiBootServicesTableLib
  UefiDriverEntryPoint
  UefiLib

[Protocols]
  gEfiTimerArchProtocolGuid
  gHardwareInterruptProtocolGuid

[Guids]
  gEfiEventExitBootServicesGuid

[FixedPcd]
  gExynos5420PkgTokenSpaceGuid.PcdMctBaseAddress
  gExynos5420PkgTokenSpaceGuid.PcdMctFrequencyHz
  gExynos5420PkgTokenSpaceGuid.PcdMctGlobalTimerIrq
  gEmbeddedTokenSpaceGuid.PcdTimerPeriod

[Depex]
  gHardwareInterruptProtocolGuid
