#
#  Raise the Cortex-A15 cluster clock (VDD_ARM via MAX77802 BUCK2,
#  then CPU dividers and APLL), early in DXE.
#
#  SPDX-License-Identifier: BSD-2-Clause-Patent
#

[Defines]
  INF_VERSION    = 0x00010005
  BASE_NAME      = Exynos5420CpuFreqDxe
  FILE_GUID      = 3c1f7e21-6a4d-4b0c-9c33-54201220c00f
  MODULE_TYPE    = DXE_DRIVER
  VERSION_STRING = 1.0

  ENTRY_POINT    = CpuFreqDxeInitialize

[Sources.common]
  CpuFreqDxe.c

[Packages]
  ArmPkg/ArmPkg.dec
  EmbeddedPkg/EmbeddedPkg.dec
  MdePkg/MdePkg.dec
  Exynos5420Pkg/Exynos5420Pkg.dec

[LibraryClasses]
  DebugLib
  IoLib
  UefiBootServicesTableLib
  UefiDriverEntryPoint

[Protocols]
  gExynosGpioProtocolGuid
  gExynosI2cProtocolGuid

[Depex]
  gExynosGpioProtocolGuid AND
  gExynosI2cProtocolGuid
