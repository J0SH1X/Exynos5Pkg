#
#  Start cores 1-3 of the boot cluster, park them in ACPI parking-protocol
#  mailboxes and install the MADT listing them.
#
#  SPDX-License-Identifier: BSD-2-Clause-Patent
#

[Defines]
  INF_VERSION    = 0x00010005
  BASE_NAME      = Exynos5420MpParkDxe
  FILE_GUID      = 3c1f7e21-6a4d-4b0c-9c33-54201220c010
  MODULE_TYPE    = DXE_DRIVER
  VERSION_STRING = 1.0

  ENTRY_POINT    = MpParkDxeInitialize

[Sources.common]
  MpParkDxe.c
  Park.S

[Packages]
  ArmPkg/ArmPkg.dec
  EmbeddedPkg/EmbeddedPkg.dec
  MdeModulePkg/MdeModulePkg.dec
  MdePkg/MdePkg.dec
  Exynos5420Pkg/Exynos5420Pkg.dec

[LibraryClasses]
  ArmLib
  BaseMemoryLib
  CacheMaintenanceLib
  DebugLib
  IoLib
  PcdLib
  UefiBootServicesTableLib
  UefiDriverEntryPoint

[Protocols]
  gEfiAcpiTableProtocolGuid

[FixedPcd]
  gArmTokenSpaceGuid.PcdGicDistributorBase
  gArmTokenSpaceGuid.PcdGicInterruptInterfaceBase

[Depex]
  gEfiAcpiTableProtocolGuid
