#
#  Exynos5420 USB peripheral driver: EFI_USBFN_IO_PROTOCOL on USB3.0 DRD0
#  (Synopsys DWC3 at 0x12000000, PHY at 0x12100000), device mode only,
#  high speed, interrupt driven.
#
#  SPDX-License-Identifier: BSD-2-Clause-Patent
#

[Defines]
  INF_VERSION    = 0x00010005
  BASE_NAME      = Exynos5420UsbFnDxe
  FILE_GUID      = 3c1f7e21-6a4d-4b0c-9c33-2a441220c008
  MODULE_TYPE    = DXE_DRIVER
  VERSION_STRING = 1.0

  ENTRY_POINT    = UsbFnDxeInitialize

[Sources.common]
  UsbFnDxe.h
  UsbFnDxe.c
  Dwc3.c
  Board.c
  SelfTest.c

[Packages]
  MdePkg/MdePkg.dec
  EmbeddedPkg/EmbeddedPkg.dec
  ArmPkg/ArmPkg.dec
  Exynos5420Pkg/Exynos5420Pkg.dec

[LibraryClasses]
  BaseLib
  BaseMemoryLib
  CacheMaintenanceLib
  DebugLib
  DxeServicesTableLib
  IoLib
  MemoryAllocationLib
  UefiBootServicesTableLib
  UefiDriverEntryPoint

[Protocols]
  gEfiUsbFunctionIoProtocolGuid
  gHardwareInterruptProtocolGuid
  gEfiCpuArchProtocolGuid

[Depex]
  gHardwareInterruptProtocolGuid AND gEfiCpuArchProtocolGuid
