[Defines]
  INF_VERSION                    = 0x00010005
  BASE_NAME                      = KeypadDeviceImplLib
  FILE_GUID                      = 3c1f7e21-6a4d-4b0c-9c33-2a441220c003
  MODULE_TYPE                    = BASE
