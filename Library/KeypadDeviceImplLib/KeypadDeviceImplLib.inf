[Packages]
  MdePkg/MdePkg.dec
  Exynos5420Pkg/Exynos5420Pkg.dec

[LibraryClasses]
  DebugLib
  IoLib
  KeypadDeviceHelperLib
  UefiBootServicesTableLib

[Protocols]
  gExynosGpioProtocolGuid
  gEFIDroidKeypadDeviceProtocolGuid
