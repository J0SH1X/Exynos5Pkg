[Defines]
  INF_VERSION    = 0x00010005
  BASE_NAME      = FrameBufferSerialPortLib
  MODULE_TYPE    = BASE
  VERSION_STRING = 1.0
  LIBRARY_CLASS  = SerialPortLib

[Sources.common]
  FrameBufferSerialPortLib.c

[Packages]
  MdePkg/MdePkg.dec
  ArmPkg/ArmPkg.dec
  Exynos5420Pkg/Exynos5420Pkg.dec

[LibraryClasses]
  ArmLib
  PcdLib
  IoLib
  HobLib
  CacheMaintenanceLib
  FrameBufferConfigLib

[Pcd]
  gExynos5420PkgTokenSpaceGuid.PcdFrameBufferAddress
  gExynos5420PkgTokenSpaceGuid.PcdFrameBufferWidth
  gExynos5420PkgTokenSpaceGuid.PcdFrameBufferHeight
  gExynos5420PkgTokenSpaceGuid.PcdFrameBufferPixelBpp

[BuildOptions]
  # 1 = paint DEBUG bytes onto the framebuffer with the 5x12 font AND append
  # them to the log ring (UsbLogDxe / usblog.py stream it to the host PC);
  # 0 = ring only, keeps the panel clean for the boot menu/splash.
  *_*_*_CC_FLAGS = -DSERIAL_TEXT_ON_SCREEN=1
