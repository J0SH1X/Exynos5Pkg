#  SPDX-License-Identifier: BSD-2-Clause-Patent
#

[Defines]
  INF_VERSION    = 0x00010005
  BASE_NAME      = ExynosResetLib
  FILE_GUID      = 9f50d4a7-3d42-4a5c-9f1e-6a0b44120e10
  MODULE_TYPE    = DXE_RUNTIME_DRIVER
  VERSION_STRING = 1.0
  LIBRARY_CLASS  = ResetSystemLib|DXE_RUNTIME_DRIVER
  CONSTRUCTOR    = ExynosResetLibConstructor

[Sources.common]
  ExynosResetLib.c

[Packages]
  MdePkg/MdePkg.dec
  MdeModulePkg/MdeModulePkg.dec
  ArmPkg/ArmPkg.dec
  Exynos5420Pkg/Exynos5420Pkg.dec

[LibraryClasses]
  BaseLib
  DebugLib
  DxeServicesTableLib
  IoLib
  PcdLib
  UefiBootServicesTableLib
  UefiRuntimeLib

[Guids]
  gEfiEventVirtualAddressChangeGuid

[FixedPcd]
  gExynos5420PkgTokenSpaceGuid.PcdPmuBaseAddress
