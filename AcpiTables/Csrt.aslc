/** @file
  Core System Resource Table: the resource groups Windows loads HAL
  extensions for.

  One group, VendorId 'SAMS' / DeviceId 0x5420, for the MCT timer extension
  (NtHalExts halextmct).  Windows looks the extension up in
  HKLM\SYSTEM\CurrentControlSet\Control\OSExtensionDatabase\VEN_SAMS&DEV_5420
  (value HALExtension = "halextmct.dll").

  halextmct is SoC independent; everything it needs about this MCT is in
  the group (layout shared with halextmct.c):
    - shared info: version 1, the OS log ring (ExynosOsLog.h) for its
      breadcrumbs,
    - a timer descriptor (Type 2 / Subtype 0): MCT base, size, counter
      frequency, GSI of global comparator 0.

  A second group, VendorId 'SAMS' / DeviceId 0x0330, for the PL330 DMA
  extension (NtHalExts halextpl330, OSExtensionDatabase\VEN_SAMS&DEV_0330):
  one DMA controller descriptor (Type 3 / Subtype 1) per PL330 (layout
  shared with halextpl330.c).  ADMA0 (audio block, 0x03880000, SPI 110 =
  GSI 142) with system request lines 0..4 = its peripherals I2S0_TX,
  I2S0S_TX, I2S0_RX, PCM0_TX, PCM0_RX (mach-exynos dma.c adma0_peri[]), all
  32-bit FIFOs.  Drivers name a request line + channel with FixedDMA in the
  DSDT.  PDMA0 (0x121A0000, SPI 34 = GSI 66) with system request lines
  32..63 = its peripherals 0..31 (exynos5420.dtsi: UART0 RX 13, TX 14,
  byte FIFOs), two channels: UART0 (Bluetooth).

  SPDX-License-Identifier: BSD-2-Clause-Patent
**/

#include <Library/AcpiLib.h>
#include <Library/PcdLib.h>
#include <ExynosOsLog.h>
#include <ExynosDmaPrograms.h>
#include "Platform.h"
#include "PlatformDma.h"

#define EFI_ACPI_CSRT_REVISION  0

#define CSRT_RD_TYPE_TIMER     2
#define CSRT_RD_SUBTYPE_TIMER  0
#define CSRT_RD_TYPE_DMA                3
#define CSRT_RD_SUBTYPE_DMA_CONTROLLER  1
#define CSRT_RD_SUBTYPE_DMA_CHANNEL     0
#define EXYNOS_ADMA0_CHANNELS           4

#define EXYNOS_ADMA0_BASE      0x03880000
#define EXYNOS_ADMA0_SIZE      0x1000
#define EXYNOS_ADMA0_GSI       (110 + 32)
#define EXYNOS_PDMA0_CHANNELS  2
#define EXYNOS_PDMA0_BASE      0x121A0000
#define EXYNOS_PDMA0_SIZE      0x1000
#define EXYNOS_PDMA0_GSI       (34 + 32)
#define EXYNOS_PDMA0_LINE_BASE 32

#pragma pack (1)
//
// Microsoft CSRT specification; same layouts as CSRT_RESOURCE_GROUP_HEADER
// and CSRT_RESOURCE_DESCRIPTOR_HEADER in the Windows DDK acpitabl.h.
//
typedef struct {
  UINT32  Length;
  UINT32  VendorId;
  UINT32  SubvendorId;
  UINT16  DeviceId;
  UINT16  SubdeviceId;
  UINT16  Revision;
  UINT16  Reserved;
  UINT32  SharedInfoLength;
} EXYNOS_CSRT_RESOURCE_GROUP_HEADER;

typedef struct {
  UINT32  Length;
  UINT16  Type;
  UINT16  Subtype;
  UINT32  Uid;
} EXYNOS_CSRT_RESOURCE_DESCRIPTOR_HEADER;

//
// halextmct: MCT_CSRT_SHARED_INFO and MCT_CSRT_TIMER.
//
typedef struct {
  UINT32  Version;
  UINT32  OsLogBase;
  UINT32  OsLogSize;
} EXYNOS_MCT_SHARED_INFO;

typedef struct {
  EXYNOS_CSRT_RESOURCE_DESCRIPTOR_HEADER  Header;
  UINT32                                  BaseAddress;
  UINT32                                  Size;
  UINT32                                  Frequency;
  UINT32                                  ComparatorGsi;
} EXYNOS_MCT_TIMER_DESCRIPTOR;

typedef struct {
  EXYNOS_CSRT_RESOURCE_GROUP_HEADER  Header;
  EXYNOS_MCT_SHARED_INFO             SharedInfo;
  EXYNOS_MCT_TIMER_DESCRIPTOR        Timer;
} EXYNOS_CSRT_MCT_GROUP;

//
// halextpl330: PL330_CSRT_SHARED_INFO and PL330_CSRT_CONTROLLER.
//
typedef struct {
  UINT32  Version;
  UINT32  OsLogBase;
  UINT32  OsLogSize;
} EXYNOS_PL330_SHARED_INFO;

typedef struct {
  EXYNOS_CSRT_RESOURCE_DESCRIPTOR_HEADER  Header;
  UINT32                                  BaseAddress;
  UINT32                                  Size;
  UINT32                                  Gsi;
  UINT32                                  ChannelCount;
  UINT32                                  RequestLineBase;
  UINT32                                  RequestLineCount;
  UINT8                                   PeripheralWidth[32];
  UINT32                                  ProgramBase;      // channel programs, 1 KiB each
  UINT32                                  ProgramSize;
} EXYNOS_PL330_CONTROLLER_DESCRIPTOR;

//
// One per channel the extension registers (Type 3 / Subtype 0, Uid =
// channel number), as Microsoft's CSRT examples list DMA channels.
//
typedef struct {
  EXYNOS_CSRT_RESOURCE_DESCRIPTOR_HEADER  Header;
  UINT32                                  ControllerUid;
  UINT32                                  ChannelNumber;
} EXYNOS_PL330_CHANNEL_DESCRIPTOR;

typedef struct {
  EXYNOS_CSRT_RESOURCE_GROUP_HEADER   Header;
  EXYNOS_PL330_SHARED_INFO            SharedInfo;
  EXYNOS_PL330_CONTROLLER_DESCRIPTOR  Adma0;
  EXYNOS_PL330_CHANNEL_DESCRIPTOR     Adma0Channel[EXYNOS_ADMA0_CHANNELS];
  EXYNOS_PL330_CONTROLLER_DESCRIPTOR  Pdma0;
  EXYNOS_PL330_CHANNEL_DESCRIPTOR     Pdma0Channel[EXYNOS_PDMA0_CHANNELS];
} EXYNOS_CSRT_PL330_GROUP;

typedef struct {
  EFI_ACPI_DESCRIPTION_HEADER  Header;
  EXYNOS_CSRT_MCT_GROUP        Mct;
#if EXYNOS_PL330_DMA
  EXYNOS_CSRT_PL330_GROUP      Pl330;
#endif
} EXYNOS_CSRT;
#pragma pack ()

EXYNOS_CSRT  Csrt = {
  EXYNOS_ACPI_HEADER (EFI_ACPI_5_0_CORE_SYSTEM_RESOURCE_TABLE_SIGNATURE,
                      EXYNOS_CSRT,
                      EFI_ACPI_CSRT_REVISION),
  {
    {
      sizeof (EXYNOS_CSRT_MCT_GROUP),         // Length
      SIGNATURE_32 ('S', 'A', 'M', 'S'),      // VendorId
      0,                                      // SubvendorId
      0x5420,                                 // DeviceId
      0,                                      // SubdeviceId
      0,                                      // Revision
      0,                                      // Reserved
      sizeof (EXYNOS_MCT_SHARED_INFO)         // SharedInfoLength
    },
    {
      1,                                      // Version
      OS_LOG_BASE,
      OS_LOG_SIZE
    },
    {
      {
        sizeof (EXYNOS_MCT_TIMER_DESCRIPTOR),
        CSRT_RD_TYPE_TIMER,
        CSRT_RD_SUBTYPE_TIMER,
        0                                     // Uid
      },
      EXYNOS_MCT_BASE,
      EXYNOS_MCT_SIZE,
      EXYNOS_MCT_FREQUENCY,
      EXYNOS_MCT_G0_GSI
    }
  },
#if EXYNOS_PL330_DMA
  {
    {
      sizeof (EXYNOS_CSRT_PL330_GROUP),       // Length
      SIGNATURE_32 ('S', 'A', 'M', 'S'),      // VendorId
      0,                                      // SubvendorId
      0x0330,                                 // DeviceId
      0,                                      // SubdeviceId
      0,                                      // Revision
      0,                                      // Reserved
      sizeof (EXYNOS_PL330_SHARED_INFO)       // SharedInfoLength
    },
    {
      1,                                      // Version
      OS_LOG_BASE,
      OS_LOG_SIZE
    },
    {
      {
        sizeof (EXYNOS_PL330_CONTROLLER_DESCRIPTOR),
        CSRT_RD_TYPE_DMA,
        CSRT_RD_SUBTYPE_DMA_CONTROLLER,
        0                                     // Uid = controller id
      },
      EXYNOS_ADMA0_BASE,
      EXYNOS_ADMA0_SIZE,
      EXYNOS_ADMA0_GSI,
      EXYNOS_ADMA0_CHANNELS,                  // channels exposed
      0,                                      // request line of peripheral 0
      5,                                      // peripherals
      { 4, 4, 4, 4, 4 },                      // FIFO access widths
      PL330_PROGRAM_BASE,
      0x1000
    },
    {
      { { sizeof (EXYNOS_PL330_CHANNEL_DESCRIPTOR), CSRT_RD_TYPE_DMA, CSRT_RD_SUBTYPE_DMA_CHANNEL, 0 }, 0, 0 },
      { { sizeof (EXYNOS_PL330_CHANNEL_DESCRIPTOR), CSRT_RD_TYPE_DMA, CSRT_RD_SUBTYPE_DMA_CHANNEL, 1 }, 0, 1 },
      { { sizeof (EXYNOS_PL330_CHANNEL_DESCRIPTOR), CSRT_RD_TYPE_DMA, CSRT_RD_SUBTYPE_DMA_CHANNEL, 2 }, 0, 2 },
      { { sizeof (EXYNOS_PL330_CHANNEL_DESCRIPTOR), CSRT_RD_TYPE_DMA, CSRT_RD_SUBTYPE_DMA_CHANNEL, 3 }, 0, 3 }
    },
    {
      {
        sizeof (EXYNOS_PL330_CONTROLLER_DESCRIPTOR),
        CSRT_RD_TYPE_DMA,
        CSRT_RD_SUBTYPE_DMA_CONTROLLER,
        1                                     // Uid = controller id
      },
      EXYNOS_PDMA0_BASE,
      EXYNOS_PDMA0_SIZE,
      EXYNOS_PDMA0_GSI,
      EXYNOS_PDMA0_CHANNELS,
      EXYNOS_PDMA0_LINE_BASE,                 // request line of peripheral 0
      32,                                     // peripherals
      { 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4,
        1, 1 },                               // 13 / 14: UART0 RX / TX, byte FIFO
      PL330_PROGRAM_BASE + 0x1000,
      0x1000
    },
    {
      { { sizeof (EXYNOS_PL330_CHANNEL_DESCRIPTOR), CSRT_RD_TYPE_DMA, CSRT_RD_SUBTYPE_DMA_CHANNEL, 0 }, 1, 0 },
      { { sizeof (EXYNOS_PL330_CHANNEL_DESCRIPTOR), CSRT_RD_TYPE_DMA, CSRT_RD_SUBTYPE_DMA_CHANNEL, 1 }, 1, 1 }
    }
  }
#endif
};

//
// Linker entry point.  A function, not a pointer variable: a pointer would be
// placed in the data section ahead of the table and GenFw would emit it too.
//
VOID *
ReferenceAcpiTable (
  VOID
  )
{
  return &Csrt;
}
