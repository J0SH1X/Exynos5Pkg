#
#  ACPI tables for v1awifi (Exynos5420): FADT, DSDT and a CSRT for the MCT
#  timer HAL extension (the MADT is built by MpParkDxe).  Built like
#  Exynos441xPkg's AcpiTables (RuleOverride = ACPITABLE in the FDF); AcpiPlatformDxe installs
#  every table it finds in this file.
#
#  SPDX-License-Identifier: BSD-2-Clause-Patent
#

[Defines]
  INF_VERSION    = 0x0001001A
  BASE_NAME      = Exynos5420AcpiTables
  # AcpiPlatformDxe looks for this name (PcdAcpiTableStorageFile default).
  FILE_GUID      = 7E374E25-8E01-4FEE-87F2-390C23C606CD
  MODULE_TYPE    = USER_DEFINED
  VERSION_STRING = 1.0

[Sources]
  Dsdt/Dsdt.asl
  Fadt.aslc
  Csrt.aslc
  Platform.h

[Packages]
  ArmPkg/ArmPkg.dec
  EmbeddedPkg/EmbeddedPkg.dec
  MdeModulePkg/MdeModulePkg.dec
  MdePkg/MdePkg.dec
  Exynos5420Pkg/Exynos5420Pkg.dec

[FixedPcd]
  gArmTokenSpaceGuid.PcdGicDistributorBase
  gArmTokenSpaceGuid.PcdGicInterruptInterfaceBase
  gExynos5420PkgTokenSpaceGuid.PcdMctBaseAddress
  gExynos5420PkgTokenSpaceGuid.PcdMctFrequencyHz
