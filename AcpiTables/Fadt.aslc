/** @file
  Fixed ACPI Description Table: hardware-reduced ACPI, no legacy blocks.

  After HtcLeoPkg's QSD8250Pkg/AcpiTables/Fadt.aslc.

  SPDX-License-Identifier: BSD-2-Clause-Patent
**/

#include <Library/AcpiLib.h>
#include "Platform.h"

EFI_ACPI_6_0_FIXED_ACPI_DESCRIPTION_TABLE  Fadt = {
  EXYNOS_ACPI_HEADER (EFI_ACPI_6_0_FIXED_ACPI_DESCRIPTION_TABLE_SIGNATURE,
                      EFI_ACPI_6_0_FIXED_ACPI_DESCRIPTION_TABLE,
                      EFI_ACPI_6_0_FIXED_ACPI_DESCRIPTION_TABLE_REVISION),
  0,                                        // FirmwareCtrl
  0,                                        // Dsdt (32-bit, XDsdt is filled in)
  EFI_ACPI_RESERVED_BYTE,                   // Reserved0
  EFI_ACPI_6_0_PM_PROFILE_TABLET,           // PreferredPmProfile
  0, 0, 0, 0, 0, 0,                         // SciInt .. PstateCnt
  0, 0, 0, 0, 0, 0, 0, 0,                   // Pm1aEvtBlk .. Gpe1Blk
  0, 0, 0, 0, 0, 0, 0, 0,                   // Pm1EvtLen .. CstCnt
  0, 0, 0, 0, 0, 0, 0, 0, 0,                // PLvl2Lat .. Century
  0,                                        // IaPcBootArch
  0,                                        // Reserved1
  EFI_ACPI_6_0_HW_REDUCED_ACPI | EFI_ACPI_6_0_LOW_POWER_S0_IDLE_CAPABLE,
  NULL_GAS,                                 // ResetReg
  0,                                        // ResetValue
  0,                                        // ArmBootArch: no PSCI
  EFI_ACPI_6_0_FIXED_ACPI_DESCRIPTION_TABLE_MINOR_REVISION,
  0,                                        // XFirmwareCtrl
  0,                                        // XDsdt: AcpiPlatformDxe
  NULL_GAS, NULL_GAS, NULL_GAS, NULL_GAS,   // XPm1a/b Evt/Cnt
  NULL_GAS, NULL_GAS, NULL_GAS, NULL_GAS,   // XPm2Cnt, XPmTmr, XGpe0/1
  NULL_GAS, NULL_GAS                        // SleepControl/Status
};

//
// Linker entry point.  A function, not a pointer variable: a pointer would be
// placed in the data section ahead of the table and GenFw would emit it too.
//
VOID *
ReferenceAcpiTable (
  VOID
  )
{
  return &Fadt;
}
